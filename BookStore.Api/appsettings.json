{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "App": { "FrontendUrl": "http://localhost:5173" },
  "Jwt": {
    "Issuer": "BookStore",
    "Audience": "BookStoreUsers",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@bookstore.local",
    "FromName": "BookStore"
  }
}